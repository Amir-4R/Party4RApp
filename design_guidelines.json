      },
      {
        "id": "avatar_astronaut",
        "url": "https://static.prod-images.emergentagent.com/jobs/2fd3e3b1-9322-4961-9b6d-db40056f5996/images/2c9153d6859216661d262d8f1a5725d1eeda03987fe7a3893426139e2cd00563.png"
      },
      {
        "id": "avatar_skull",
        "url": "https://static.prod-images.emergentagent.com/jobs/2fd3e3b1-9322-4961-9b6d-db40056f5996/images/f55dcb868c9bdeb03ce5912467520adf4b09fa4b2d71ba9a21e8cca3b664695b.png"
      },
      {
        "id": "avatar_alien",
        "url": "https://static.prod-images.emergentagent.com/jobs/2fd3e3b1-9322-4961-9b6d-db40056f5996/images/eafe4503b44f3b955b91ebe64dd0176afe89e2a405acad0b4d82ade7bb5c8966.png"
      },
      {
        "id": "avatar_robot",
        "url": "https://static.prod-images.emergentagent.com/jobs/2fd3e3b1-9322-4961-9b6d-db40056f5996/images/0b0ea51f9ba491da3116b8c31b2c1c18556ac4129b1d81aae3e37a21172434c1.png"
      },
      {
        "id": "avatar_cat",
        "url": "https://static.prod-images.emergentagent.com/jobs/2fd3e3b1-9322-4961-9b6d-db40056f5996/images/f5701e045a5d35f44a19e7cf722d824430077a3827a1a7790fb0ac6fa3c0f490.png"
      }
    ]
  },
  "testing_attributes": {
    "rule": "Every interactive and key informational element MUST include a `testID` attribute (React Native equivalent of data-testid).",
    "convention": "kebab-case, role-based",
    "examples": [
      "testID='login-form-submit-button'",
      "testID='room-card-join-button'",
      "testID='chat-message-input'",
      "testID='avatar-select-robot'"
    ]
  },
  "instructions_to_main_agent": [
    "This is a React Native Expo application. Apply the style tokens using React Native's StyleSheet API or a styling library of your choice (like NativeWind/Tailwind) mapping to the hex codes provided.",
    "Implement the strict Portrait vs Landscape logic using React Native's Dimensions API or expo-screen-orientation. Landscape must automatically hide the chat and expand the video.",
    "For the UI, avoid standard iOS/Android native grays. Stick strictly to the #0B0B0F, #15151A, and #1C1C22 palette.",
    "Use Phosphor Icons or Lucide Icons (lucide-react-native) for navigation and actions.",
    "Ensure the WebView allows inline media playback to function correctly as a co-watching player."
  ]
}